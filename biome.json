{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!scripts/bin",
      "!scripts/dashboard/template.html",
      "!test/fixtures",
      "!agents/**/*.md",
      "!commands/**/*.md",
      "!skills/**/*.md"
    ]
  }
}
